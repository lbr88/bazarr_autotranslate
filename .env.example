# Copy to .env and fill in real values. Never commit .env.

BAZARR_BASE_URL=http://localhost:6767
BAZARR_API_KEY=YOUR_API_KEY

BASE_LANGUAGES=en
TO_LANGUAGES=da

# Optional
LINGARR_URL=http://localhost:9870
LINGARR_CHECK_INTERVAL=30
LINGARR_CLEAR_QUEUE_ON_STARTUP=false

NUM_WORKERS=2
DUAL_QUEUE=true
BATCH_SIZE=50
INTERVAL_BETWEEN_SCANS=300
TRANSLATION_REQUEST_TIMEOUT=900
MAX_RETRIES=3
MIN_TRANSLATION_TIME=10.0

SERIES_SCAN=true
MOVIES_SCAN=true

WEB_UI=true
WEB_UI_PORT=6700
FLASK_SECRET_KEY=YOUR_RANDOM_SECRET

LOG_LEVEL=INFO
LOG_DIRECTORY=logs/
